# Senate Chef — environment variables
# Copy this file to ".env" and fill in your Supabase project values.
# Only EXPO_PUBLIC_* vars are exposed to the app bundle. The anon key is safe to
# ship — security is enforced by Row-Level Security + RPCs (see supabase/migrations).

# Project URL, e.g. https://abcdefgh.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Public "anon" API key (Project Settings → API → Project API keys → anon public)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public web address of this deployment. Used to build links that are shared
# outside the app (e.g. the WhatsApp digest) — they point at <site>/open, which
# opens the app if installed and falls back to the Play Store.
EXPO_PUBLIC_SITE_URL=https://my-aangan.vercel.app
